{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/css/(.+\\.(?:css|min\\.css))(\\?.*)?$",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
        "Vary": "Accept-Encoding"
      },
      "dest": "/api/index.php"
    },
    {
      "src": "/js/(.+\\.js)(\\?.*)?$",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
        "Vary": "Accept-Encoding"
      },
      "dest": "/api/index.php"
    },
    {
      "src": "/images/(.+\\.(?:png|jpg|jpeg|gif|svg|ico|webp))(\\?.*)?$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Vary": "Accept-Encoding"
      },
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
